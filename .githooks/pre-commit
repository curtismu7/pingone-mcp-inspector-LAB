#!/bin/sh
# Refuse a commit that stages a secret. Installed by `npm install` (core.hooksPath).
if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks protect --staged --redact
fi
echo "pre-commit: gitleaks is not installed (brew install gitleaks), so this commit cannot be scanned and is refused. Use git commit --no-verify only if you have scanned it another way." >&2
exit 1
